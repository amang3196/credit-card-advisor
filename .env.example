# Copy this file to .env and fill in your keys.

# https://app.pinecone.io -> API Keys (free Starter plan is enough)
PINECONE_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Only needed if you use a Gemini model (LLM_MODEL=gemini/... or EVAL_PROVIDER=gemini)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model for the agents and the baseline (CrewAI format: provider/model)
LLM_MODEL=openai/gpt-5.4-mini
# Gemini alternative:
# LLM_MODEL=gemini/gemini-3.5-flash-lite

# RAGAS judge: provider (openai or gemini) + model name without prefix
EVAL_PROVIDER=openai
EVAL_LLM_MODEL=gpt-5.4-mini
# Judge requests per minute (defaults: 60 for openai, 12 for the Gemini free tier)
# EVAL_RPM=60

# Optional overrides
PINECONE_INDEX=card-advisor
PINECONE_NAMESPACE=cards
TOP_K=6
# PDF chunking at ingestion: v2.1 = v2 + merged table cells restored (default),
# v2 = Markdown sections + whole tables, v1 = page windows.
# Re-run `python -m app.ingest --reset` after changing it.
CHUNKER=v2.1
# Rules Researcher prompt: v3 (default) adds category-coverage / base-rate / fee-row rules; v2 = earlier prompt
RESEARCHER_PROMPT=v3
# Requests per minute per agent
MAX_RPM=30
# Seconds per LLM attempt before retrying
LLM_TIMEOUT=60
